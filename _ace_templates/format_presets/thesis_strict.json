{
  "name": "严格学术论文格式",
  "description": "符合多数高校学位论文要求：正文小四号宋体 + 1.5倍行距，标题三号黑体",
  "page": {
    "width_cm": 21,
    "height_cm": 29.7,
    "top_margin_cm": 3.0,
    "bottom_margin_cm": 2.5,
    "left_margin_cm": 3.0,
    "right_margin_cm": 2.5
  },
  "heading": {
    "font_cn": "黑体",
    "font_en": "Times New Roman",
    "font_size_pt": 16,
    "bold": true,
    "color": "000000"
  },
  "body": {
    "font_cn": "宋体",
    "font_en": "Times New Roman",
    "font_size_pt": 12,
    "first_line_indent_chars": 2,
    "line_spacing_multiple": 1.5,
    "left_indent_cm": 0,
    "right_indent_cm": 0,
    "space_before_pt": 0,
    "space_after_pt": 0
  },
  "table": {
    "font_cn": "宋体",
    "font_en": "Times New Roman",
    "font_size_pt": 9,
    "header_bold": true,
    "alignment": "center",
    "border_top_sz": 12,
    "border_bottom_sz": 12,
    "border_header_bottom_sz": 6
  },
  "table_title": {
    "font_cn": "黑体",
    "font_en": "Times New Roman",
    "font_size_pt": 10.5,
    "bold": true,
    "alignment": "center",
    "space_before_pt": 12,
    "space_after_pt": 6
  },
  "note": {
    "font_cn": "宋体",
    "font_en": "Times New Roman",
    "font_size_pt": 8,
    "line_spacing_multiple": 1.5,
    "space_before_pt": 0,
    "space_after_pt": 0
  }
}
