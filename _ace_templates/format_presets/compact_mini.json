{
  "name": "紧凑迷你格式",
  "description": "适用于表格密集/内容多的报告，节省页面空间",
  "page": {
    "width_cm": 21,
    "height_cm": 29.7,
    "top_margin_cm": 2.0,
    "bottom_margin_cm": 2.0,
    "left_margin_cm": 2.5,
    "right_margin_cm": 2.0
  },
  "heading": {
    "font_cn": "黑体",
    "font_en": "Times New Roman",
